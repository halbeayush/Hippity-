# Copy to .env (local) and fill in. On Vercel, set these in
# Project → Settings → Environment Variables instead. Never commit real values.

# --- Database (Neon Postgres) -------------------------------------------
# Pooled connection string — the host contains "-pooler". Used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct (unpooled) connection string — same but without "-pooler". Used by
# `prisma migrate` (see prisma.config.ts). Optional locally if you only
# have one URL; required on Vercel because the build runs migrations.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Sessions -----------------------------------------------------------
# Signs session cookies (src/lib/sessionCookie.ts). Any long random string,
# e.g. `openssl rand -base64 32`. Changing it signs everyone out.
SESSION_SECRET=""

# --- Last.fm ------------------------------------------------------------
# https://www.last.fm/api/account/create — used for album info and the
# Upcoming row.
LASTFM_API_KEY=""
# Issued alongside the key. Needed for "Sign in with Last.fm" (the weekly
# top 5 on the Social tab); without it that button shows an error.
LASTFM_SHARED_SECRET=""

# --- Google sign-in (optional) -------------------------------------------
# Without these the "Continue with Google" button shows an error and
# username/password sign-in still works. The OAuth client's authorized
# redirect URI must be <your site>/api/auth/google/callback, e.g.
#   http://localhost:3000/api/auth/google/callback
#   https://your-app.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Spotify (not used by the app yet) ------------------------------------
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# --- Vercel Blob (optional) -----------------------------------------------
# Keeps fetched album covers across deploys and server instances. Vercel
# connects a Blob store (Storage → Create → Blob, access: Private) through
# OIDC and sets BLOB_STORE_ID itself; a read-write token also works. Without
# either, covers are cached on local disk only.
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
